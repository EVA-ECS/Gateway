{
  "Urls": "http://localhost:5000;https://localhost:5001",
  "Logging": {
    "LogLevel": {
      "Yarp": "Warning",
      "Microsoft": "Warning",
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "chat-route": {
        "ClusterId": "storage-cluster",
        "Match": {
          "Path": "/api/chat/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "storage-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://storage-service:8080"
          }
        }
      }
    }
  }
}