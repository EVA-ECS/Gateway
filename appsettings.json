{
  "Logging": {
    "LogLevel": {
      "Yarp": "Warning",
      "Microsoft": "Warning",
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RabbitMQ": {
    "Host": "rabbitmq",
    "Username": "admin",
    "Password": "secret"
  },
  "Redis": {
    "ConnectionString": "redis:6379"
  },
  "Supabase": {
    "Url": "https://svjwdxhozkulzgxxyzce.supabase.co"
  },
  "ReverseProxy": {
    "Routes": {
      "ticket-route": {
        "ClusterId": "ticket-cluster",
        "Match": {
          "Path": "/api/ticket/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "ticket-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://ticket-service:8080"
          }
        }
      }
    }
  }
}
