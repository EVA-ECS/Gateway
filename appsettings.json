{
  "Logging": {
    "LogLevel": {
      "Yarp": "Warning",
      "Microsoft": "Warning",
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RabbitMQ": {
    "Host": "rabbitmq",
    "Username": "admin",
    "Password": "secret"
  },
  "Redis": {
    "ConnectionString": "redis:6379",
    "PresenceKeyPrefix": "presence:",
    "PresenceTtlSeconds": 60,
    "SingleGatewayDeliveryChannel": "gateway:delivery"
  },
  "Supabase": {
    "Url": "https://svjwdxhozkulzgxxyzce.supabase.co"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-register-route": {
        "ClusterId": "user-service-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/auth/register",
          "Methods": [
            "POST"
          ]
        }
      },
      "auth-login-route": {
        "ClusterId": "user-service-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/auth/login",
          "Methods": [
            "POST"
          ]
        }
      },
      "auth-refresh-route": {
        "ClusterId": "user-service-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/auth/refresh",
          "Methods": [
            "POST"
          ]
        }
      },
      "auth-logout-route": {
        "ClusterId": "user-service-cluster",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/auth/logout",
          "Methods": [
            "POST"
          ]
        }
      },
      "user-list-route": {
        "ClusterId": "user-service-cluster",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/users",
          "Methods": [
            "GET"
          ]
        }
      },
      "ticket-route": {
        "ClusterId": "ticket-cluster",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/ticket/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "user-service-cluster": {
        "Destinations": {
          "user-service": {
            "Address": "http://user-service:8080/"
          }
        }
      },
      "ticket-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://ticket-service:8080/"
          }
        }
      }
    }
  }
}